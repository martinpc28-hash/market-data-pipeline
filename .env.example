# Copiá este archivo como ".env" (sin el ".example") y completá tus valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ver .gitignore).

KALSHI_API_KEY_ID=tu_key_id_aqui
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
KALSHI_ENV=demo

# Fase 4 — TimescaleDB (coinciden con docker-compose.yml; si los cambiás
# acá, cambialos también ahí, o el contenedor arranca con otro usuario/clave).
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=market_data
TIMESCALE_USER=market_data
TIMESCALE_PASSWORD=market_data

# Fase 4 — MinIO (ídem, coinciden con docker-compose.yml).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-data-raw
MINIO_SECURE=false
